# GFIC 2.0 服务端环境变量模板
# 用法：在部署目录复制为 .env，或修改 docker-compose.yml 的 environment 段。
# 安全：密钥仅存服务端环境变量或受保护的 config.json，**绝不发送到浏览器**。
# 本文件不含真实密钥，可安全纳入版本管理。

# AI 模型（OpenAI 兼容接口，用户已有的内网 freellmapi 网关）
FR_LLM_BASE=http://192.168.10.110:3001/v1
FR_LLM_KEY=

# 外网代理（本机与 NAS 容器经此代理访问境外官方数据源）
FR_PROXY=http://192.168.10.107:7893

# 容器运行：不自动打开浏览器
FR_NO_BROWSER=1

# 端口固定 6789，如需变更请同时改 config.json 与 compose 端口映射
# GFIC_PORT=6789
